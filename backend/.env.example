PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
DATABASE_PATH=./data/ethio_guest_house.db
CORS_ORIGIN=*
# Local: http://localhost:3000
# Production domain: https://ethioguesthouses.com
PUBLIC_BASE_URL=http://localhost:3000
# Listing currency is USD (min $50). Stored/paid as ETB using this rate.
USD_ETB_RATE=57
MIN_NIGHTLY_USD=50
# Demo OTP code when NODE_ENV=development
OTP_DEMO_CODE=123456
ADMIN_API_KEY=dev-admin-key
# Session length (host/admin stay signed in longer)
JWT_EXPIRES_GUEST=30d
JWT_EXPIRES_HOST=180d
JWT_EXPIRES_ADMIN=365d
# --- SMS OTP ---
# console | twilio | http | none
# Local default: console (OTP logged to server terminal; use OTP_DEMO_CODE)
SMS_PROVIDER=console
SMS_FROM_NAME=AddisAbabaGH
# Twilio (international; works for +251 if your Twilio account supports it)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# Generic HTTP gateway (AfroMessage, GeezSMS, custom Ethiopian SMS API)
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://api.example.com/sms/send
# SMS_HTTP_API_KEY=your-key
# SMS_HTTP_API_KEY_HEADER=Authorization
# SMS_HTTP_FROM=AddisAbabaGH
# Optional JSON template; placeholders: {{to}} {{message}} {{from}}
# SMS_HTTP_BODY_TEMPLATE={"to":"{{to}}","message":"{{message}}","from":"{{from}}"}
# Public website contact details (replace with your real numbers)
CONTACT_EMAIL=addisuabebaw23@gmail.com
CONTACT_PHONE=+251988013094
CONTACT_WHATSAPP=+251988013094
CONTACT_VIBER=+251988013094
CONTACT_LABEL=Addis Ababa Guest Houses
